@{
    Layout = "~/Views/Shared/_Layout.cshtml";  // Use the main layout
}

<h2>Welcome to CRMConnect</h2>

<div class="row">

    <div class="col-md-3">
        <div class="card text-white bg-secondary mb-3">
            <div class="card-header">Customer Profiles</div>
            <div class="card-body">
                <p>Manage customer details and interactions.</p>
                <a href="/Customers" class="btn btn-light">View Customers</a>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white bg-primary mb-3">
            <div class="card-header">Sales Tracking</div>
            <div class="card-body">
                <p>Track sales activities and leads.</p>
                <a href="/SalesTracking" class="btn btn-light">Go to Sales</a>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white bg-success mb-3">
            <div class="card-header">Task Management</div>
            <div class="card-body">
                <p>Assign and track tasks for sales reps.</p>
                <a href="/TaskManagement" class="btn btn-light">Go to Tasks</a>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white bg-warning mb-3">
            <div class="card-header">Communication Log</div>
            <div class="card-body">
                <p>Record all customer interactions.</p>
                <a href="/CommunicationLog" class="btn btn-light">View Logs</a>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white bg-danger mb-3">
            <div class="card-header">Admin Panel</div>
            <div class="card-body">
                <p>Manage users and settings.</p>
                <a href="/AdminPanel" class="btn btn-light">Go to Admin</a>
            </div>
        </div>
    </div>
</div>
