<!DOCTYPE html>
<html>
<head>
    <title>CRMConnect</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">CRMConnect</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" href="/Dashboard">Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/CustomerProfiles">Customer Profiles</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/SalesTracking">Sales Tracking</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/TaskManagement">Task Management</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/CommunicationLog">Communication Log</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/AdminPanel">Admin Panel</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        @RenderBody()  <!-- This will load the content of each page -->
    </div>
</body>
</html>
